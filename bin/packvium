#!/usr/bin/env php
<?php
declare(strict_types=1);
require dirname(__DIR__) . '/autoload.php';
use Packvium\Serialization\ArrayCodec;
use Packvium\Support\PrettyJsonStream;
$input = stream_get_contents(STDIN);
if ($input === false || trim($input) === '') { fwrite(STDERR, "Expected packing JSON on stdin\n"); exit(2); }
// Streamed, not `echo json_encode(...)`: the encoded result is never held next to its array.
try { $result=ArrayCodec::pack(json_decode($input,true,512,JSON_THROW_ON_ERROR)); PrettyJsonStream::write($result,STDOUT); fwrite(STDOUT,"\n"); }
catch(Throwable $e){ fwrite(STDERR,$e->getMessage()."\n"); exit(1); }
