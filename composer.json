{
  "name": "packvium/packvium",
  "description": "Deterministic, extensible 3D cartonization and container packing library with exact metric and imperial units.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "3d-bin-packing",
    "cartonization",
    "container-loading",
    "packing",
    "logistics"
  ],
  "homepage": "https://github.com/toxakara/packvium-php",
  "support": {
    "issues": "https://github.com/toxakara/packvium-php/issues",
    "source": "https://github.com/toxakara/packvium-php",
    "security": "https://github.com/toxakara/packvium-php/blob/main/SECURITY.md"
  },
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "Packvium\\": "src/"
    },
    "files": [
      "src/Commerce/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Packvium\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/packvium"
  ],
  "scripts": {
    "test": "php tests/run.php",
    "lint": "find src tests examples -type f -name '*.php' -print0 | xargs -0 -n1 php -l && php -l bin/packvium"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
