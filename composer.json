{
    "name": "packvium/packvium",
    "description": "Deterministic 3D bin-packing and cartonization engine for pallets, containers, trucks and shipping cartons. Exact integer geometry, reproducible results.",
    "type": "library",
    "suggest": {
        "packvium/native-bridge": "Routes solves through the Rust core over FFI when a shared library is available, with identical results."
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Packvium contributors",
            "homepage": "https://packvium.com"
        }
    ],
    "keywords": [
        "3d-bin-packing",
        "bin-packing",
        "3d-packing",
        "cartonization",
        "container-loading",
        "pallet-packing",
        "truck-loading",
        "packing-algorithm",
        "logistics",
        "deterministic"
    ],
    "homepage": "https://packvium.com",
    "support": {
        "docs": "https://packvium.com/docs",
        "issues": "https://github.com/toxakara/packvium-php/issues",
        "source": "https://github.com/toxakara/packvium-php",
        "security": "https://github.com/toxakara/packvium-php/blob/main/SECURITY.md"
    },
    "require": {
        "php": ">=7.3"
    },
    "archive": {
        "exclude": [
            "/vendor",
            "/COVERAGE.md",
            "/coverage-baseline.json",
            "/.phpunit.cache"
        ]
    },
    "autoload": {
        "psr-4": {
            "Packvium\\": "src/"
        },
        "files": [
            "autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Packvium\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/packvium"
    ],
    "scripts": {
        "test": "php tests/run.php",
        "lint": "find src tests examples -type f -name '*.php' -print0 | xargs -0 -n1 php -l && php -l bin/packvium"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
